<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Handsfreely.App.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Handsfreely.App.Localization"
    xmlns:local="using:Handsfreely.App.Views">

    <Grid Padding="24,16,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{x:Bind loc:L.T('nav.messages')}" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="6">
                    <Button Click="OnNewClick" ToolTipService.ToolTip="{x:Bind loc:L.T('sms.new')}">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button Click="OnRefreshClick" ToolTipService.ToolTip="{x:Bind loc:L.T('common.refresh')}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
            <ListView x:Name="Threads" Grid.Row="1" SelectionChanged="OnThreadSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ThreadItem">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="36" Height="36" Initials="{x:Bind Initials}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind Weight, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Snippet, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{x:Bind When, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                <InfoBadge Value="{x:Bind Thread.Unread, Mode=OneWay}" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid x:Name="Conversation" Grid.Column="1" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PeerName" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="PeerNumber" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Click="OnCallPeerClick" ToolTipService.ToolTip="{x:Bind loc:L.T('calls.call')}">
                    <FontIcon Glyph="&#xE717;" FontSize="16" />
                </Button>
            </Grid>
            <ListView x:Name="MessagesList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MessageItem">
                        <StackPanel HorizontalAlignment="{x:Bind Alignment}" MaxWidth="480" Margin="0,4">
                            <Border Background="{x:Bind Background}" CornerRadius="12" Padding="12,8">
                                <TextBlock Text="{x:Bind Body}" Foreground="{x:Bind Foreground}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                            <TextBlock Text="{x:Bind When}" HorizontalAlignment="{x:Bind Alignment}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="4,2" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ComposeBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MaxHeight="140"
                    PlaceholderText="{x:Bind loc:L.T('sms.placeholder')}"
                    KeyDown="OnComposeKeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="OnSendClick" ToolTipService.ToolTip="{x:Bind loc:L.T('sms.send')}">
                    <FontIcon Glyph="&#xE724;" FontSize="16" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
