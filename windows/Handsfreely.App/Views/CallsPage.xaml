<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Handsfreely.App.Views.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Handsfreely.App.Localization"
    xmlns:local="using:Handsfreely.App.Views">

    <Grid Padding="24,16,24,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="10">
            <TextBlock Text="{x:Bind loc:L.T('calls.dial')}" Style="{StaticResource PageTitleStyle}" />
            <TextBox
                x:Name="NumberBox"
                FontSize="26"
                TextAlignment="Center"
                InputScope="TelephoneNumber"
                PlaceholderText="{x:Bind loc:L.T('calls.number')}"
                TextChanged="OnNumberChanged"
                KeyDown="OnNumberKeyDown" />
            <TextBlock
                x:Name="MatchText"
                MinHeight="20"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="Pad" HorizontalAlignment="Center" />
            <Grid Margin="0,8,0,0" HorizontalAlignment="Center" Width="232">
                <Button
                    x:Name="CallButton"
                    Style="{StaticResource GreenCallButtonStyle}"
                    Click="OnCallClick"
                    ToolTipService.ToolTip="{x:Bind loc:L.T('calls.call')}">
                    <FontIcon Glyph="&#xE717;" FontSize="24" />
                </Button>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBackspaceClick"
                    ToolTipService.ToolTip="{x:Bind loc:L.T('calls.erase')}">
                    <FontIcon Glyph="&#xE750;" />
                </Button>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{x:Bind loc:L.T('calls.recent')}" Style="{StaticResource PageTitleStyle}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshClick" ToolTipService.ToolTip="{x:Bind loc:L.T('common.refresh')}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <ListView
                x:Name="RecentList"
                Grid.Row="1"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnRecentClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CallLogItem">
                        <Grid Padding="4,8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" Foreground="{x:Bind Brush}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind When}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Duration}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="360"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
