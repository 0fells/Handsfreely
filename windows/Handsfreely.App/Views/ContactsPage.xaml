<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Handsfreely.App.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Handsfreely.App.Localization"
    xmlns:local="using:Handsfreely.App.Views">

    <Grid Padding="24,16,24,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{x:Bind loc:L.T('nav.contacts')}" Style="{StaticResource PageTitleStyle}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshClick" ToolTipService.ToolTip="{x:Bind loc:L.T('common.refresh')}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                QueryIcon="Find"
                PlaceholderText="{x:Bind loc:L.T('contacts.search')}"
                TextChanged="OnSearchChanged" />
            <ListView
                x:Name="List"
                Grid.Row="2"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ContactItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="36" Height="36" Initials="{x:Bind Initials}" ProfilePicture="{x:Bind Photo, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind FirstNumber}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="EmptyText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border x:Name="Details" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Visibility="Collapsed" Padding="24">
            <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <PersonPicture x:Name="DetailPicture" Width="72" Height="72" />
                    <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl x:Name="NumbersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NumberItem">
                            <Grid Padding="0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Number}" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Type}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Tag="{x:Bind Number}" Click="OnCallNumberClick" ToolTipService.ToolTip="{x:Bind loc:L.T('calls.call')}">
                                    <FontIcon Glyph="&#xE717;" FontSize="16" />
                                </Button>
                                <Button Grid.Column="2" Tag="{x:Bind Number}" Click="OnSmsNumberClick" ToolTipService.ToolTip="{x:Bind loc:L.T('sms.write')}">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Page>
