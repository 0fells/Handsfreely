<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Handsfreely.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Handsfreely.App.Localization">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind loc:L.T('nav.settings')}" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind loc:L.T('settings.language')}" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="180" SelectionChanged="OnLanguageChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="TrayToggle" Header="{x:Bind loc:L.T('settings.tray')}" Toggled="OnTrayToggled" />
                    <ToggleSwitch x:Name="StartupToggle" Header="{x:Bind loc:L.T('settings.startup')}" Toggled="OnStartupToggled" />
                    <TextBlock x:Name="StartupHint" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="SmsToggle" Header="{x:Bind loc:L.T('settings.smstoasts')}" Toggled="OnSmsToggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Handsfreely" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind loc:L.T('settings.about')}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/0fells/Handsfreely" />
                        <Button Content="{x:Bind loc:L.T('settings.openlog')}" Click="OnOpenLogClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
