<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Handsfreely.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Handsfreely">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Handsfreely" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" VerticalAlignment="Center">
                <StackPanel x:Name="PhoneStatus" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                    <TextBlock x:Name="PhoneName" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <FontIcon x:Name="BatteryIcon" Glyph="&#xE83F;" FontSize="14" Margin="6,0,0,0" />
                    <TextBlock x:Name="BatteryText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <FontIcon x:Name="SignalIcon" Glyph="&#xEC37;" FontSize="14" Margin="6,0,0,0" />
                    <FontIcon x:Name="AudioIcon" Glyph="&#xE7F6;" FontSize="14" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavCalls" Tag="Calls" Icon="Phone" />
                <NavigationViewItem x:Name="NavContacts" Tag="Contacts" Icon="Contact" />
                <NavigationViewItem x:Name="NavMessages" Tag="Messages" Icon="Message" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavDevices" Tag="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Tag="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="Banner" Margin="24,12,24,0" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="BannerButton" Click="OnBannerButtonClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
